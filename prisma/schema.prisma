generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTIONIST
  HOST
}

enum VisitorStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  password         String
  name             String
  role             Role           @default(RECEPTIONIST)
  department       String?
  phone            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  hostedVisitors   Visitor[]      @relation("HostVisitors")
  approvedVisitors Visitor[]      @relation("ApproverVisitors")

  @@map("users")
}

model Visitor {
  id               Int            @id @default(autoincrement())
  fullName         String
  email            String
  phone            String
  company          String?
  purpose          String
  badgeNumber      String?
  status           VisitorStatus  @default(PENDING)
  checkInTime      DateTime       @default(now())
  checkOutTime     DateTime?
  notes            String?        @db.Text
  rejectionReason  String?        @db.Text

  // Host relation
  hostUserId       Int?
  host             User?          @relation("HostVisitors", fields: [hostUserId], references: [id], onDelete: SetNull)
  hostName         String?

  // Approval relation
  approvedById     Int?
  approvedBy       User?          @relation("ApproverVisitors", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("visitors")
}
